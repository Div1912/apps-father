# ── Per-project worker runtime (DEV-only) ─────────────────────────────────
# When RUNTIME_MODE=worker, user routes.js is executed inside isolated
# child Node processes (one per project, dropped to per-project Linux user).
# RUNNER_SECRET gates the worker's internal /__worker/* endpoints. Leave it
# empty to auto-generate at boot — fine for DEV. PROD stays on in-process.
RUNTIME_MODE=worker
RUNNER_SECRET=
RUNNER_PROJECTS_ROOT=/srv/apps-father/projects

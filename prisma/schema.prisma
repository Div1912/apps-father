generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int       @id @default(autoincrement())
  telegramId BigInt    @unique @map("telegram_id")
  username   String?
  firstName  String?   @map("first_name")
  balance    Decimal   @default(0) @db.Decimal(12, 4)
  /** TON balance (internal, used for App Store token creation + buying). */
  tonBalance Decimal   @default(0) @map("ton_balance") @db.Decimal(18, 9)
  credits    Int       @default(50)
  appSlots   Int       @default(5) @map("app_slots")
  referredBy BigInt?   @map("referred_by")
  utmSource  String?   @map("utm_source")
  language   String    @default("en")
  createdAt  DateTime  @default(now()) @map("created_at")

  isPartner           Boolean  @default(false) @map("is_partner")
  partnerPercent      Decimal? @map("partner_percent") @db.Decimal(5, 2)
  partnerTag          String?  @unique @map("partner_tag")
  partnerReferralBonus Decimal? @map("partner_referral_bonus") @db.Decimal(12, 4)
  partnerBalance      Decimal  @default(0) @map("partner_balance") @db.Decimal(12, 4)
  firstDepositBonusGiven Boolean @default(false) @map("first_deposit_bonus_given")
  adminNotifiedAt     DateTime? @map("admin_notified_at")
  // Set the first time the user claims the "follow our channel" bonus
  // (apps_father). Used as the once-per-user gate — non-null means the
  // 0.10 USD has already landed on their balance and the modal must not
  // award them again, even if they unsubscribe and resubscribe later.
  subBonusClaimedAt   DateTime? @map("sub_bonus_claimed_at")

  // CRM-only: comma-free JSON array of free-form tags ("VIP", "Refunded", …).
  // Stored as JSON-encoded String so we don't need a junction table.
  adminTags  String?  @map("admin_tags")

  projects        Project[]
  conversations   Conversation[]
  payments        Payment[]
  usageLogs       UsageLog[]
  agentSessions   AgentSession[]
  withdrawals     Withdrawal[]
  retentionPushes RetentionPush[]
  adminNotes      AdminUserNote[]
  taskCompletions TaskCompletion[]
  agentFeedback   AgentFeedback[]
  tonTopups       TonTopup[]
  balanceLedger   BalanceLedger[]
  tonWithdrawals  TonWithdrawal[]

  @@map("users")
}

// CRM-only: timeline of admin-authored notes attached to a user.
model AdminUserNote {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  body      String
  authorTag String   @default("admin") @map("author_tag")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_user_notes")
}

model RetentionPush {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  scenario  String
  sentAt    DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scenario])
  @@index([userId])
  @@map("retention_pushes")
}

model Project {
  id               String   @id @default(uuid())
  userId           Int      @map("user_id")
  name             String
  description      String?
  appDescription   String?  @map("app_description")
  appLongDescription String? @map("app_long_description")
  appMenuButtonText String? @map("app_menu_button_text")
  status           String   @default("created")
  botUserId        BigInt?  @map("bot_user_id")
  botUsername       String?  @map("bot_username")
  botTokenEncrypted String? @map("bot_token_encrypted")
  currentVersion   String?  @map("current_version")
  plan             String?
  generatedCode    String?  @map("generated_code")
  projectSummary   String?  @map("project_summary")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  totalCostUsd  Decimal        @default(0) @map("total_cost_usd") @db.Decimal(12, 4)
  features      String?        @map("features")
  tonWallet     String?        @map("ton_wallet")
  qualityTier   Int            @default(1) @map("quality_tier")
  releaseCommit Int?           @map("release_commit")
  lastTaskId    String?        @map("last_task_id")

  // ── Per-project worker runtime (Phase 1, DEV) ─────────────────────────
  /// 127.0.0.1 listener port allocated lazily on first worker spawn.
  workerPort     Int?    @unique @map("worker_port")
  /// Cached afp_<10hex(sha256(id))> for ops/admin lookup. Populated by
  /// the migration script and on first provision.
  workerUsername String? @map("worker_username")

  user          User           @relation(fields: [userId], references: [id])
  versions      Version[]
  assets        Asset[]
  conversations Conversation[]
  usageLogs     UsageLog[]
  agentSessions AgentSession[]
  appLogs       AppLog[]
  agentFeedback AgentFeedback[]
  listing       AppListing?

  @@map("projects")
}

// ── App Store ────────────────────────────────────────────────────────────────
// Public marketplace listing for a project. Created by the owner from the
// mini app, reviewed by an admin, then deployed (jetton master created).
model AppListing {
  id               String    @id @default(uuid())
  projectId        String    @unique @map("project_id")
  // draft → review → published. Or rejected.
  status           String    @default("draft")
  // App name displayed on the listing (may differ from project name).
  appName          String?   @map("app_name") @db.VarChar(64)
  shortDescription String?   @map("short_description") @db.VarChar(120)
  longDescription  String?   @map("long_description")
  // JSON: { telegram?: string, twitter?: string, website?: string, ... }
  socials          Json?
  category         String?
  // JSON: array of strings (max ~10) — free-form tags shown on the App Store
  // listing card. Stored as JSON for portability across SQL/Mongo backends.
  tags             Json?
  // Bucket filename of the App Store-specific app logo (replaces the
  // bot avatar fetched from Telegram). Editable at any time.
  appLogoFilename  String?   @map("app_logo_filename")
  // Bucket filename of a single banner image shown at the top of the App
  // Store detail page (similar to Apple's "preview hero" image).
  bannerFilename   String?   @map("banner_filename")
  // JSON: array of strings — bucket filenames (4-6 screenshots).
  screenshots      Json?
  // Initial liquidity in TON (internal, not on-chain).
  initialLiquidityTon Float? @map("initial_liquidity_ton")
  // JSON: per-language text overrides { ru: {name, short, long}, ua: {...} }
  translations     Json?
  // 5 TON publishing fee tx hash on TON. Set when user submits.
  publishFeeTxHash String?   @map("publish_fee_tx_hash")
  submittedAt      DateTime? @map("submitted_at")
  approvedAt       DateTime? @map("approved_at")
  approvedBy       Int?      @map("approved_by")
  rejectedReason   String?   @map("rejected_reason")
  publishedAt      DateTime? @map("published_at")
  hidden           Boolean   @default(false)
  // Cached counters for store sorting (updated on each trade).
  volume24hNanoTon BigInt    @default(0) @map("volume_24h_nano_ton")
  marketCapNanoTon BigInt    @default(0) @map("market_cap_nano_ton")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  token            AppToken?

  @@index([status, hidden])
  @@map("app_listings")
}

// On-chain TON Jetton + on-chain liquidity pool (custodial AMM).
//
// V2 model: the user (publisher) signs the Jetton master deployment from
// their own wallet via TonConnect. The Jetton master `admin_address` is the
// USER, so they truly own the token on-chain. Initial liquidity (TON +
// tokens) is then sent by the user to the platform vault, with the user
// recorded as the sole liquidity provider. LP can be added/removed later.
//
// AMM is constant-product against the REAL on-chain reserves
// (realTonReserve, realTokenReserve). No more virtual reserves.
//
// Reserves / supply are stored as BigInt (atomic units / nanoTON).
model AppToken {
  id                  String   @id @default(uuid())
  projectId           String   @unique @map("project_id")
  listingId           String   @unique @map("listing_id")
  name                String
  symbol              String
  // Optional Jetton metadata description (TIP-64). Empty by default to
  // match the minter.ton.org preset. Independent from the App Store
  // listing's shortDescription (which is an app-store-card concept).
  metadataDescription String?  @map("metadata_description")
  // bucket filename for token logo (separate from app logo).
  logoFilename        String   @map("logo_filename")
  // EQ-form jetton master address. Null until deploy succeeds.
  jettonMasterAddress String?  @unique @map("jetton_master_address")
  deployTxHash        String?  @map("deploy_tx_hash")
  // The publisher's TON wallet address — they signed the deploy and own the
  // Jetton master (= jetton admin). They are also the initial sole LP.
  ownerWalletAddress  String?  @map("owner_wallet_address")
  // 1B * 10^9 atomic units by default.
  totalSupply         BigInt   @map("total_supply")
  // Legacy: kept so existing rows still parse. Always 0 for V2 tokens.
  curveSupplyCap      BigInt   @default(0) @map("curve_supply_cap")
  virtualTonReserve   BigInt   @default(0) @map("virtual_ton_reserve")
  virtualTokenReserve BigInt   @default(0) @map("virtual_token_reserve")
  // Real liquidity reserves — held by the platform vault, AMM math runs
  // against these. Updated atomically on every trade and LP event.
  realTonReserve      BigInt   @default(0) @map("real_ton_reserve")
  realTokenReserve    BigInt   @default(0) @map("real_token_reserve")
  // Total LP shares minted across all positions. Uniswap V2-style:
  //   first add → shares = sqrt(ton * tokens)
  //   later add → shares = min(Δton/ton, Δtokens/tokens) * total
  lpTotalShares       BigInt   @default(0) @map("lp_total_shares")
  // Legacy curve counter — total tokens that ever entered circulation
  // through the platform; kept for charts but not used by the AMM.
  soldSupply          BigInt   @default(0) @map("sold_supply")
  // Accumulated trading fees, in nanoTON.
  feeBalanceNanoTon   BigInt   @default(0) @map("fee_balance_nano_ton")
  creatorFeeBalanceNanoTon BigInt @default(0) @map("creator_fee_balance_nano_ton")
  // pending_deploy → deployed_pending_lp → live → halted.
  status              String   @default("pending_deploy")
  /** When the user paid the initial liquidity to create the token (PF2 flow). */
  creationPaidAt              DateTime? @map("creation_paid_at")
  /** TON amount the user locked at token creation. */
  creationLockedLiquidityTon  Decimal?  @map("creation_locked_liquidity_ton") @db.Decimal(18, 9)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  listing             AppListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  trades              TokenTrade[]
  holdings            TokenHolding[]
  liquidityPositions  LiquidityPosition[]
  liquidityEvents     LiquidityEvent[]

  @@map("app_tokens")
}

// Liquidity-provider position. ONE row per (token, owner_wallet_address).
// `shares` are added on lp_init / lp_add and decreased on lp_remove. They
// behave like Uniswap V2 LP tokens.
model LiquidityPosition {
  id                String   @id @default(uuid())
  tokenId           String   @map("token_id")
  // App-internal user (denorm so we can show "your portfolio" quickly).
  userId            Int?     @map("user_id")
  // The TON wallet that signed the LP transfer — sole source of truth.
  ownerWalletAddress String  @map("owner_wallet_address")
  shares            BigInt   @default(0)
  // Cumulative TON / tokens deposited via this position (for P&L).
  cumTonDepositedNano   BigInt @default(0) @map("cum_ton_deposited_nano")
  cumTokenDeposited     BigInt @default(0) @map("cum_token_deposited")
  cumTonWithdrawnNano   BigInt @default(0) @map("cum_ton_withdrawn_nano")
  cumTokenWithdrawn     BigInt @default(0) @map("cum_token_withdrawn")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt      @map("updated_at")

  token             AppToken @relation(fields: [tokenId], references: [id])

  @@unique([tokenId, ownerWalletAddress])
  @@index([userId])
  @@index([tokenId])
  @@map("liquidity_positions")
}

// History of every LP event. Append-only.
model LiquidityEvent {
  id                String   @id @default(uuid())
  tokenId           String   @map("token_id")
  positionId        String?  @map("position_id")
  ownerWalletAddress String  @map("owner_wallet_address")
  // "init" | "add" | "remove".
  type              String
  // Signed amounts: positive on add, negative on remove.
  tonNano           BigInt   @map("ton_nano")
  tokenAmount       BigInt   @map("token_amount")
  shares            BigInt
  txHash            String?  @map("tx_hash")
  // pending → settled (set when both legs detected).
  status            String   @default("settled")
  createdAt         DateTime @default(now()) @map("created_at")

  token             AppToken @relation(fields: [tokenId], references: [id])

  @@index([tokenId, createdAt])
  @@index([ownerWalletAddress])
  @@map("liquidity_events")
}

model TokenTrade {
  id           String   @id @default(uuid())
  tokenId      String   @map("token_id")
  userId       Int      @map("user_id")
  type         String   // "buy" | "sell"
  // Gross TON the user paid (buy) or received (sell), in nanoTON.
  tonAmount    BigInt   @map("ton_amount")
  // Token amount in atomic units.
  tokenAmount  BigInt   @map("token_amount")
  // Effective price = tonAmount / tokenAmount, denormalised for chart speed.
  priceNanoTon BigInt   @map("price_nano_ton")
  feeTonAmount BigInt   @map("fee_ton_amount")
  // Incoming user → platform tx (TON for buy, Jetton for sell).
  txHashIn     String?  @map("tx_hash_in")
  // Outgoing platform → user tx (Jetton for buy, TON for sell).
  txHashOut    String?  @map("tx_hash_out")
  // pending_payment → received → settled. Or failed.
  status       String   @default("pending_payment")
  createdAt    DateTime @default(now()) @map("created_at")
  settledAt    DateTime? @map("settled_at")

  token        AppToken @relation(fields: [tokenId], references: [id])

  @@index([tokenId, createdAt])
  @@index([userId])
  @@index([status])
  @@map("token_trades")
}

model TokenHolding {
  tokenId       String   @map("token_id")
  userId        Int      @map("user_id")
  // Atomic token units currently held via the platform's accounting.
  balance       BigInt   @default(0)
  // Weighted-average buy price for P&L calculation, in nanoTON per atomic unit.
  avgBuyNanoTon BigInt   @default(0) @map("avg_buy_nano_ton")
  updatedAt     DateTime @updatedAt @map("updated_at")

  token         AppToken @relation(fields: [tokenId], references: [id])

  @@id([tokenId, userId])
  @@index([userId])
  @@map("token_holdings")
}

model Version {
  id        Int      @id @default(autoincrement())
  projectId String   @map("project_id")
  version   String
  changelog String?
  snapshot  String?
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])

  @@map("versions")
}

model Asset {
  id          Int      @id @default(autoincrement())
  projectId   String   @map("project_id")
  fileId      String   @map("file_id")
  filePath    String?  @map("file_path")
  fileName    String?  @map("file_name")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])

  @@map("assets")
}

model Conversation {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  projectId String?  @map("project_id")
  state     String
  context   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@map("conversations")
}

model Bundle {
  id            String    @id @default(cuid())
  name          String
  credits       Int
  bonusCredits  Int       @default(0) @map("bonus_credits")
  priceUsd      Decimal   @map("price_usd") @db.Decimal(12, 4)
  discount      Int       @default(0)     // percentage 0-100; if >0 shows strikethrough in UI
  isLimited     Boolean   @default(false) @map("is_limited")
  limitTotal    Int?      @map("limit_total")
  purchaseCount Int       @default(0)     @map("purchase_count")
  isActive      Boolean   @default(true)  @map("is_active")
  sortOrder     Int       @default(0)     @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")

  payments Payment[]

  @@map("bundles")
}

model Payment {
  id                   Int       @id @default(autoincrement())
  userId               Int       @map("user_id")
  amountUsd            Decimal   @map("amount_usd") @db.Decimal(12, 4)
  status               String    @default("pending")
  nowpaymentsId        String?   @map("nowpayments_id")
  nowpaymentsInvoiceUrl String?  @map("nowpayments_invoice_url")
  createdAt            DateTime  @default(now()) @map("created_at")
  confirmedAt          DateTime? @map("confirmed_at")
  bundleId             String?   @map("bundle_id")
  creditsGranted       Int?      @map("credits_granted")
  bonusCredits         Int?      @map("bonus_credits")
  method               String?

  user   User    @relation(fields: [userId], references: [id])
  bundle Bundle? @relation(fields: [bundleId], references: [id])

  @@map("payments")
}

model Voucher {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  amountUsd   Decimal   @default(0) @map("amount_usd") @db.Decimal(12, 4)
  credits     Int       @default(0)
  maxUses     Int       @map("max_uses")
  usedCount   Int       @default(0) @map("used_count")
  active      Boolean   @default(true)
  payingOnly  Boolean   @default(false) @map("paying_only")
  createdAt   DateTime  @default(now()) @map("created_at")

  redemptions VoucherRedemption[]

  @@map("vouchers")
}

model VoucherRedemption {
  id         Int      @id @default(autoincrement())
  voucherId  Int      @map("voucher_id")
  userId     Int      @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  voucher Voucher @relation(fields: [voucherId], references: [id])

  @@unique([voucherId, userId])
  @@map("voucher_redemptions")
}

model Withdrawal {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  amountUsd   Decimal   @map("amount_usd") @db.Decimal(12, 4)
  tonAddress  String    @map("ton_address")
  status      String    @default("pending")
  txHash      String?   @map("tx_hash")
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  user User @relation(fields: [userId], references: [id])

  @@map("withdrawals")
}

/** TON balance withdrawal requests — auto-sent from hot wallet on submit */
model TonWithdrawal {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  amountTon   Decimal   @map("amount_ton") @db.Decimal(18, 9)
  tonAddress  String    @map("ton_address")
  status      String    @default("pending")  // pending | approved | failed
  txHash      String?   @map("tx_hash")
  adminNote   String?   @map("admin_note")
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  user User @relation(fields: [userId], references: [id])

  @@map("ton_withdrawals")
}

model UsageLog {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  projectId       String?  @map("project_id")
  inputTokens     Int      @map("input_tokens")
  outputTokens    Int      @map("output_tokens")
  costUsd         Decimal  @map("cost_usd") @db.Decimal(12, 6)
  operation       String
  creditsCharged  Int?     @map("credits_charged")
  taskId          String?  @map("task_id")
  createdAt       DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@map("usage_logs")
}

// Single log record for every agent session (router, answer, build, update, etc.)
model AgentSession {
  id             String   @id @default(cuid())
  projectId      String?  @map("project_id")
  userId         Int?     @map("user_id")
  type           String                         // AgentSessionType
  model          String
  input          String                         // summarised user prompt / router output
  output         String?                        // final result summary
  creditsCharged Int      @default(0)  @map("credits_charged")
  // Aggregate USD cost reported by OpenRouter for the whole session.
  // Sum of every iteration's `usage.cost`. Used as the authoritative
  // figure in the admin Sessions table.
  costUsd        Decimal  @default(0)  @map("cost_usd") @db.Decimal(12, 6)
  // Input/output split of `costUsd` from
  // `usage.cost_details.upstream_inference_prompt_cost` and
  // `…completions_cost`. Sums across iterations like costUsd. Nullable on
  // legacy rows that pre-date OR usage accounting.
  costUsdInput   Decimal? @map("cost_usd_input")  @db.Decimal(12, 6)
  costUsdOutput  Decimal? @map("cost_usd_output") @db.Decimal(12, 6)
  inputTokens    Int      @default(0)  @map("input_tokens")
  outputTokens   Int      @default(0)  @map("output_tokens")
  durationMs     Int?     @map("duration_ms")
  success        Boolean  @default(true)
  // Router-classified complexity bucket (trivial|small|medium|large|huge).
  // Null on free sessions and on legacy rows from before the matrix landed.
  complexity     String?
  // True when the user enabled MAX MODE before clicking Build/Start. Drives
  // model selection in _runCoreAgent and the credit markup in billing.
  isMaxMode      Boolean  @default(false) @map("is_max_mode")
  createdAt      DateTime @default(now()) @map("created_at")

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("agent_sessions")
}

// Persistent runtime log line. Captured by the tee installed in
// console-tagger.service.ts and flushed in batches by app-log.service.ts.
//
// `projectId` is nullable: lines emitted outside a `runWithProject` ALS
// context (i.e. core daemon / cron / startup output) are stored with
// `projectId = null` and surfaced as the "System" scope in the Admin UI.
//
// `category` is derived from existing bracket prefixes (`[Agent]`,
// `[Builder]`, `[BotRunner]`, `[API]`, …); see `parseCategory` in
// app-log.service.ts. Lines without a recognized tag fall back to
// "Backend" (when project-scoped) or "System" (when not).
model AppLog {
  id        BigInt   @id @default(autoincrement())
  ts        DateTime @default(now())
  projectId String?  @map("project_id")
  category  String
  level     String
  source    String
  message   String

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([ts(sort: Desc)])
  @@index([projectId, ts(sort: Desc)])
  @@index([category, ts(sort: Desc)])
  @@index([projectId, category, ts(sort: Desc)])
  @@map("app_logs")
}

model Task {
  id           Int      @id @default(autoincrement())
  title        Json                           // { en, ru, uk }
  description  Json                           // { en, ru, uk }
  imageUrl     String?  @map("image_url")
  reward       Int                            // credits
  link         String
  type         String                         // "open_link" | "channel_subscribe"
  payload      String?                        // channel ID / username for subscribe check
  targeting    String   @default("all")       // "all" | "en" | "ru" | "uk"
  delaySeconds Int      @default(5)  @map("delay_seconds")
  isActive     Boolean  @default(true)  @map("is_active")
  sortOrder    Int      @default(0)    @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  completions TaskCompletion[]

  @@map("tasks")
}

model TaskCompletion {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_completions")
}

// Agent training: short text rules learned from user feedback.
// `enabled=true` rules are injected into buildSystemPrompt() at runtime.
// Per-env state (enabled, timestamps, importedFrom, sourceCaseId) is NOT exported.
model AgentLesson {
  id           String    @id                              // stable cuid for cross-env match
  rule         String                                      // text injected into system prompt
  context      String?                                     // when this rule applies
  tags         String[]  @default([])                      // ["forms", "validation", "ui"]
  enabled      Boolean   @default(false)                   // PER-ENV state, NOT exported
  notes        String?                                     // admin commentary, IS exported
  sourceCaseId String?   @map("source_case_id")            // FK to future AgentFeedback
  contentHash  String    @map("content_hash")              // sha256(rule+context+tags)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt      @map("updated_at")
  enabledAt    DateTime? @map("enabled_at")
  disabledAt   DateTime? @map("disabled_at")
  importedFrom String?   @map("imported_from")             // "prod" / "dev" / null

  @@index([enabled])
  @@map("agent_lessons")
}

// User feedback case ("cashback issue") collected after each agent run.
// Stores the user's rating + the context needed to analyze what went wrong:
// the prompt, the credits charged, before/after commit numbers (the agent.log
// is loaded lazily from disk at commits/{commitNumAfter}/agent.log).
//
// analysisStatus lifecycle:
//   pending      — created on submit; nothing analyzed yet
//   learning     — admin clicked "Run Analysis"; LLM running in background
//   result_ready — LLM returned suggestedLessons/Patches; awaiting admin review
//   applied      — admin clicked "Apply"; appliedLessonIds/PatchIds populated
//   skipped      — admin marked as no-op
model AgentFeedback {
  id               String    @id @default(cuid())
  projectId        String    @map("project_id")
  userId           Int       @map("user_id")
  userPrompt       String    @map("user_prompt")
  commitNumBefore  Int?      @map("commit_num_before")
  commitNumAfter   Int?      @map("commit_num_after")
  creditsCharged   Int       @default(0) @map("credits_charged")

  isCorrect        Boolean   @map("is_correct")
  qualityScore     Int       @map("quality_score")
  speedScore       Int       @map("speed_score")
  userDescription  String?   @map("user_description")

  // Performance tier the run actually used (looked up from UsageLog.tierId
  // at submit time). Helps the admin spot tier-related quality issues.
  performanceTier  String?   @map("performance_tier")

  cashbackCredits  Int       @default(0) @map("cashback_credits")
  cashbackPaidAt   DateTime? @map("cashback_paid_at")

  analysisStatus   String    @default("pending") @map("analysis_status")
  analysisResult   Json?     @map("analysis_result")
  analysisModel    String?   @map("analysis_model")
  analysisError    String?   @map("analysis_error")
  appliedAt        DateTime? @map("applied_at")
  appliedLessonIds String[]  @default([]) @map("applied_lesson_ids")
  appliedPatchIds  String[]  @default([]) @map("applied_patch_ids")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt      @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([userId, projectId, commitNumAfter])
  @@index([analysisStatus])
  @@index([userId])
  @@index([projectId])
  @@map("agent_feedback")
}

// Agent training: text suggestions for editing the agent's own source/instructions.
// NEVER auto-applied — admin reviews, copies cursorPrompt to IDE, applies manually.
// Status: proposed → applied / rejected. Per-env status NOT exported.
model AgentCodePatch {
  id            String    @id                              // stable cuid for cross-env match
  title         String                                     // short label
  problem       String                                     // what's broken in agent behavior
  targetFiles   String[]  @default([]) @map("target_files") // paths to touch
  suggestion    String                                     // free-form description of change
  cursorPrompt  String    @map("cursor_prompt")            // ready-to-paste prompt for IDE
  tags          String[]  @default([])
  status        String    @default("proposed")             // proposed | applied | rejected
  notes         String?                                    // admin commentary, IS exported
  sourceCaseId  String?   @map("source_case_id")
  contentHash   String    @map("content_hash")             // sha256 of exported fields
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt      @map("updated_at")
  appliedAt     DateTime? @map("applied_at")
  rejectedAt    DateTime? @map("rejected_at")
  appliedCommit String?   @map("applied_commit")           // optional git SHA
  importedFrom  String?   @map("imported_from")

  @@index([status])
  @@map("agent_code_patches")
}

/** Unified ledger of every balance change (credits, TON, tokens) per user.
 *  amount > 0 = credited to user, amount < 0 = debited from user.
 *  source vocabulary: payment | agent_usage | refund | admin_grant |
 *    referral_bonus | first_deposit_bonus | sub_bonus | task | cashback |
 *    ton_topup | swap_buy | swap_sell
 */
model BalanceLedger {
  id        BigInt   @id @default(autoincrement())
  userId    Int      @map("user_id")
  currency  String   // "credits" | "TON" | token symbol e.g. "EST"
  amount    Decimal  @db.Decimal(18, 9)  // positive = in, negative = out
  source    String
  meta      Json?    // { paymentId?, taskId?, projectId?, tokenSymbol?, note? }
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("balance_ledger")
}

/** Tracks TON top-up requests initiated from the Wallet page. */
model TonTopup {
  id          String    @id @default(cuid())
  userId      Int       @map("user_id")
  amountTon   Decimal   @map("amount_ton") @db.Decimal(18, 9)
  amountNano  String    @map("amount_nano")
  /** pending → confirmed | expired */
  status      String    @default("pending")
  txHash      String?   @map("tx_hash")
  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("ton_topups")
}

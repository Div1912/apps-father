generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int       @id @default(autoincrement())
  telegramId BigInt    @unique @map("telegram_id")
  username   String?
  firstName  String?   @map("first_name")
  balance    Decimal   @default(0) @db.Decimal(12, 4)
  credits    Int       @default(0)
  performanceTier String @default("tier_1") @map("performance_tier")
  appSlots   Int       @default(5) @map("app_slots")
  referredBy BigInt?   @map("referred_by")
  utmSource  String?   @map("utm_source")
  language   String    @default("en")
  createdAt  DateTime  @default(now()) @map("created_at")

  isPartner           Boolean  @default(false) @map("is_partner")
  partnerPercent      Decimal? @map("partner_percent") @db.Decimal(5, 2)
  partnerTag          String?  @unique @map("partner_tag")
  partnerReferralBonus Decimal? @map("partner_referral_bonus") @db.Decimal(12, 4)
  partnerBalance      Decimal  @default(0) @map("partner_balance") @db.Decimal(12, 4)
  firstDepositBonusGiven Boolean @default(false) @map("first_deposit_bonus_given")
  adminNotifiedAt     DateTime? @map("admin_notified_at")
  // Set the first time the user claims the "follow our channel" bonus
  // (apps_father). Used as the once-per-user gate — non-null means the
  // 0.10 USD has already landed on their balance and the modal must not
  // award them again, even if they unsubscribe and resubscribe later.
  subBonusClaimedAt   DateTime? @map("sub_bonus_claimed_at")

  // CRM-only: comma-free JSON array of free-form tags ("VIP", "Refunded", …).
  // Stored as JSON-encoded String so we don't need a junction table.
  adminTags  String?  @map("admin_tags")

  projects        Project[]
  conversations   Conversation[]
  payments        Payment[]
  usageLogs       UsageLog[]
  withdrawals     Withdrawal[]
  retentionPushes RetentionPush[]
  adminNotes      AdminUserNote[]

  @@map("users")
}

// CRM-only: timeline of admin-authored notes attached to a user.
model AdminUserNote {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  body      String
  authorTag String   @default("admin") @map("author_tag")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_user_notes")
}

model RetentionPush {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  scenario  String
  sentAt    DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scenario])
  @@index([userId])
  @@map("retention_pushes")
}

model Project {
  id               String   @id @default(uuid())
  userId           Int      @map("user_id")
  name             String
  description      String?
  appDescription   String?  @map("app_description")
  appLongDescription String? @map("app_long_description")
  appMenuButtonText String? @map("app_menu_button_text")
  status           String   @default("created")
  botUserId        BigInt?  @map("bot_user_id")
  botUsername       String?  @map("bot_username")
  botTokenEncrypted String? @map("bot_token_encrypted")
  currentVersion   String?  @map("current_version")
  plan             String?
  generatedCode    String?  @map("generated_code")
  projectSummary   String?  @map("project_summary")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  totalCostUsd  Decimal        @default(0) @map("total_cost_usd") @db.Decimal(12, 4)
  features      String?        @map("features")
  preferences   String?        @map("preferences")
  tonWallet     String?        @map("ton_wallet")
  qualityTier   Int            @default(1) @map("quality_tier")
  releaseCommit Int?           @map("release_commit")

  user          User           @relation(fields: [userId], references: [id])
  versions      Version[]
  assets        Asset[]
  conversations Conversation[]
  usageLogs     UsageLog[]
  appLogs       AppLog[]

  @@map("projects")
}

model Version {
  id        Int      @id @default(autoincrement())
  projectId String   @map("project_id")
  version   String
  changelog String?
  snapshot  String?
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])

  @@map("versions")
}

model Asset {
  id          Int      @id @default(autoincrement())
  projectId   String   @map("project_id")
  fileId      String   @map("file_id")
  filePath    String?  @map("file_path")
  fileName    String?  @map("file_name")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])

  @@map("assets")
}

model Conversation {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  projectId String?  @map("project_id")
  state     String
  context   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@map("conversations")
}

model Bundle {
  id            String    @id @default(cuid())
  name          String
  credits       Int
  bonusCredits  Int       @default(0) @map("bonus_credits")
  priceUsd      Decimal   @map("price_usd") @db.Decimal(12, 4)
  discount      Int       @default(0)     // percentage 0-100; if >0 shows strikethrough in UI
  isLimited     Boolean   @default(false) @map("is_limited")
  limitTotal    Int?      @map("limit_total")
  purchaseCount Int       @default(0)     @map("purchase_count")
  isActive      Boolean   @default(true)  @map("is_active")
  sortOrder     Int       @default(0)     @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")

  payments Payment[]

  @@map("bundles")
}

model Payment {
  id                   Int       @id @default(autoincrement())
  userId               Int       @map("user_id")
  amountUsd            Decimal   @map("amount_usd") @db.Decimal(12, 4)
  status               String    @default("pending")
  nowpaymentsId        String?   @map("nowpayments_id")
  nowpaymentsInvoiceUrl String?  @map("nowpayments_invoice_url")
  createdAt            DateTime  @default(now()) @map("created_at")
  confirmedAt          DateTime? @map("confirmed_at")
  bundleId             String?   @map("bundle_id")
  creditsGranted       Int?      @map("credits_granted")
  bonusCredits         Int?      @map("bonus_credits")
  method               String?

  user   User    @relation(fields: [userId], references: [id])
  bundle Bundle? @relation(fields: [bundleId], references: [id])

  @@map("payments")
}

model Voucher {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  amountUsd   Decimal   @default(0) @map("amount_usd") @db.Decimal(12, 4)
  credits     Int       @default(0)
  maxUses     Int       @map("max_uses")
  usedCount   Int       @default(0) @map("used_count")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  redemptions VoucherRedemption[]

  @@map("vouchers")
}

model VoucherRedemption {
  id         Int      @id @default(autoincrement())
  voucherId  Int      @map("voucher_id")
  userId     Int      @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  voucher Voucher @relation(fields: [voucherId], references: [id])

  @@unique([voucherId, userId])
  @@map("voucher_redemptions")
}

model Withdrawal {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  amountUsd   Decimal   @map("amount_usd") @db.Decimal(12, 4)
  tonAddress  String    @map("ton_address")
  status      String    @default("pending")
  txHash      String?   @map("tx_hash")
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  user User @relation(fields: [userId], references: [id])

  @@map("withdrawals")
}

model UsageLog {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  projectId       String?  @map("project_id")
  inputTokens     Int      @map("input_tokens")
  outputTokens    Int      @map("output_tokens")
  costUsd         Decimal  @map("cost_usd") @db.Decimal(12, 6)
  operation       String
  creditsCharged  Int?     @map("credits_charged")
  tierId          String?  @map("tier_id")
  createdAt       DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@map("usage_logs")
}

// Persistent runtime log line. Captured by the tee installed in
// console-tagger.service.ts and flushed in batches by app-log.service.ts.
//
// `projectId` is nullable: lines emitted outside a `runWithProject` ALS
// context (i.e. core daemon / cron / startup output) are stored with
// `projectId = null` and surfaced as the "System" scope in the Admin UI.
//
// `category` is derived from existing bracket prefixes (`[Agent]`,
// `[Builder]`, `[BotRunner]`, `[API]`, …); see `parseCategory` in
// app-log.service.ts. Lines without a recognized tag fall back to
// "Backend" (when project-scoped) or "System" (when not).
model AppLog {
  id        BigInt   @id @default(autoincrement())
  ts        DateTime @default(now())
  projectId String?  @map("project_id")
  category  String
  level     String
  source    String
  message   String

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([ts(sort: Desc)])
  @@index([projectId, ts(sort: Desc)])
  @@index([category, ts(sort: Desc)])
  @@index([projectId, category, ts(sort: Desc)])
  @@map("app_logs")
}

'use strict';

// ─── Init Telegram ───────────────────────────────────────────────────────────
Telegram.WebApp.ready();
Telegram.WebApp.expand();
Telegram.WebApp.setHeaderColor('#000000');
Telegram.WebApp.setBottomBarColor('#000000');
Telegram.WebApp.setBackgroundColor('#000000');
Telegram.WebApp.disableVerticalSwipes();
if (Telegram.WebApp.platform === 'ios' || Telegram.WebApp.platform === 'android') {
  Telegram.WebApp.requestFullscreen();
}

const tgUser = Telegram.WebApp.initDataUnsafe?.user || {};
const MY_ID = tgUser.id?.toString() || 'demo_' + Math.random().toString(36).substr(2, 6);
const API_BASE = '/api/a91afbe9-cbfb-4998-a498-3b6a6aad58b7';

// ─── State ────────────────────────────────────────────────────────────────────
const state = {
  user: null,
  models: [],
  activeTab: 'lab',
  filterTier: 'all',
  selectedModel: null,
  poolInfo: null,
  pendingTaps: 0,
  tapFlushTimer: null,
  countdownInterval: null,
};

// ─── API Helper ───────────────────────────────────────────────────────────────
async function apiCall(endpoint, options = {}) {
  const headers = {
    'Content-Type': 'application/json',
    'Authorization': 'Bearer ' + (Telegram.WebApp?.initData || ''),
    ...(options.headers || {})
  };
  const res = await fetch(API_BASE + endpoint, { ...options, headers });
  if (!res.ok) {
    const err = await res.json().catch(() => ({ error: 'Unknown' }));
    throw Object.assign(new Error(err.message || err.error || 'Error'), { status: res.status, data: err });
  }
  return res.json();
}

// ─── Toast ────────────────────────────────────────────────────────────────────
let toastTimer = null;
function showToast(msg, duration = 2500) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), duration);
}

// ─── Navigation ───────────────────────────────────────────────────────────────
const TABS = ['lab', 'inventory', 'market', 'exchange'];

function switchTab(tab) {
  if (state.activeTab === tab) return;
  state.activeTab = tab;
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('screen-' + tab).classList.add('active');
  document.querySelectorAll('.nav-btn').forEach((b, i) => {
    b.classList.toggle('active', b.dataset.tab === tab);
  });
  // move indicator
  const idx = TABS.indexOf(tab);
  document.getElementById('nav-indicator').style.left = (idx * 25) + '%';
  Telegram.WebApp.HapticFeedback.selectionChanged();
  // lazy load
  if (tab === 'inventory') loadInventory();
  if (tab === 'market') loadMarket();
  if (tab === 'exchange') loadPool();
}

document.querySelectorAll('.nav-btn').forEach(btn => {
  btn.addEventListener('click', () => switchTab(btn.dataset.tab));
});

// ─── User Init ────────────────────────────────────────────────────────────────
async function initUser() {
  try {
    const user = await apiCall('/user', {
      method: 'POST',
      body: JSON.stringify({
        telegramId: MY_ID,
        firstName: tgUser.first_name || 'User',
        username: tgUser.username || ''
      })
    });
    state.user = user;
    updateLabUI();
    updateHeaderUI();
    // also load inventory in background
    loadInventory(true);
  } catch (e) {
    console.error('initUser error', e);
    showToast('⚠️ Connection error — retrying...');
    setTimeout(initUser, 3000);
  }
}

function updateHeaderUI() {
  if (!state.user) return;
  const zoom = Math.floor(state.user.zoom || 0);
  document.getElementById('hdr-zoom').textContent = formatNum(zoom);
  document.getElementById('my-zoom-balance').textContent = formatNum(zoom);
}

// ─── Lab Screen ───────────────────────────────────────────────────────────────
const TAP_BTN = document.getElementById('tap-btn');
const CRAFT_BTN = document.getElementById('craft-btn');
const MAT_COUNT = document.getElementById('mat-count');
const MAT_BAR = document.getElementById('mat-progress-bar');
const MAT_LABEL = document.getElementById('mat-progress-label');
const CRAFT_COST = 50;

function updateLabUI() {
  if (!state.user) return;
  const mats = Math.floor(state.user.materials || 0);
  MAT_COUNT.textContent = formatNum(mats);
  const pct = Math.min((mats / CRAFT_COST) * 100, 100);
  MAT_BAR.style.width = pct + '%';
  MAT_LABEL.textContent = mats + ' / ' + CRAFT_COST;
  const canCraft = mats >= CRAFT_COST;
  CRAFT_BTN.disabled = !canCraft;
  CRAFT_BTN.classList.toggle('ready', canCraft);
  // quick stats
  const active = state.models.filter(m => m.status === 'active');
  document.getElementById('qs-models').textContent = state.models.length;
  document.getElementById('qs-active').textContent = active.length;
  const zoomRate = active.reduce((s, m) => s + (m.zoomPerHour || 0), 0);
  document.getElementById('qs-zoom').textContent = zoomRate;
}

// tap button
let tapAnimFrame = null;
TAP_BTN.addEventListener('click', (e) => {
  // haptic
  Telegram.WebApp.HapticFeedback.impactOccurred('light');
  // particles
  spawnParticles(e);
  // update local state immediately
  state.user.materials = (state.user.materials || 0) + 1;
  updateLabUI();
  // batch taps
  state.pendingTaps++;
  clearTimeout(state.tapFlushTimer);
  state.tapFlushTimer = setTimeout(flushTaps, 600);
});

async function flushTaps() {
  if (!state.pendingTaps) return;
  const taps = state.pendingTaps;
  state.pendingTaps = 0;
  try {
    const data = await apiCall('/tap', {
      method: 'POST',
      body: JSON.stringify({ telegramId: MY_ID, taps })
    });
    state.user.materials = data.materials;
    state.user.zoom = data.zoom;
    updateLabUI();
    updateHeaderUI();
  } catch (e) {
    console.error('flush taps error', e);
  }
}

function spawnParticles(e) {
  const wrap = document.getElementById('tap-particles');
  const rect = TAP_BTN.getBoundingClientRect();
  const cx = rect.left + rect.width / 2;
  const cy = rect.top + rect.height / 2;
  const count = 4;
  for (let i = 0; i < count; i++) {
    const p = document.createElement('div');
    p.className = 'particle';
    p.textContent = '+1';
    const angle = (Math.random() * 60 - 30);
    const px = cx - wrap.getBoundingClientRect().left + (Math.random() - 0.5) * 60;
    const py = cy - wrap.getBoundingClientRect().top;
    p.style.left = px + 'px';
    p.style.top = py + 'px';
    p.style.setProperty('--angle', angle + 'deg');
    wrap.appendChild(p);
    setTimeout(() => p.remove(), 900);
  }
}

// craft button
CRAFT_BTN.addEventListener('click', async () => {
  if (!state.user || (state.user.materials || 0) < CRAFT_COST) return;
  CRAFT_BTN.disabled = true;
  CRAFT_BTN.innerHTML = '<span class="craft-icon">⌛</span><span class="craft-text">Crafting…</span>';
  Telegram.WebApp.HapticFeedback.impactOccurred('medium');
  try {
    const data = await apiCall('/craft', {
      method: 'POST',
      body: JSON.stringify({ telegramId: MY_ID })
    });
    state.user.materials = data.materials;
    updateLabUI();
    showCraftResult(data.model);
    // add to local models
    state.models.push(data.model);
    updateLabUI();
  } catch (e) {
    showToast('Craft failed: ' + (e.message || 'error'));
  } finally {
    CRAFT_BTN.innerHTML = '<span class="craft-icon">✨</span><span class="craft-text">Craft Model</span><span class="craft-cost">50 materials</span>';
  }
});

// ─── Craft Result Modal ───────────────────────────────────────────────────────
function showCraftResult(model) {
  document.getElementById('cr-emoji').textContent = model.emoji;
  document.getElementById('cr-name').textContent = model.name;
  document.getElementById('cr-category').textContent = model.category;
  document.getElementById('cr-zoom-rate').textContent = model.zoomPerHour;
  document.getElementById('cr-ton-fee').textContent = model.tonFee + ' TON';
  const badge = document.getElementById('cr-tier-badge');
  badge.textContent = model.tier;
  badge.className = 'cr-tier-badge ' + model.tier;
  openModal('modal-craft');
  Telegram.WebApp.HapticFeedback.notificationOccurred('success');
}

document.getElementById('cr-go-inv-btn').addEventListener('click', () => {
  closeModal('modal-craft');
  switchTab('inventory');
});
document.getElementById('cr-close-btn').addEventListener('click', () => {
  closeModal('modal-craft');
});

// ─── Inventory Screen ─────────────────────────────────────────────────────────
async function loadInventory(silent = false) {
  try {
    const data = await apiCall('/inventory/' + MY_ID);
    state.models = data.models || [];
    if (state.user) {
      state.user.zoom = data.zoom;
      updateHeaderUI();
    }
    renderInventory();
    updateLabUI();
  } catch (e) {
    if (!silent) showToast('Error loading inventory');
  }
}

function renderInventory() {
  const grid = document.getElementById('models-grid');
  const empty = document.getElementById('inv-empty');
  const filtered = state.filterTier === 'all'
    ? state.models
    : state.models.filter(m => m.tier === state.filterTier);

  // zoom label
  if (state.user) {
    document.getElementById('inv-zoom-label').textContent =
      formatNum(Math.floor(state.user.zoom || 0)) + ' $ZOOM earned';
  }

  if (!filtered.length) {
    grid.innerHTML = '';
    grid.appendChild(empty.cloneNode(true));
    document.getElementById('inv-empty').style.display = 'flex';
    return;
  }

  grid.innerHTML = filtered.map(m => modelCardHTML(m)).join('');

  // click handlers
  grid.querySelectorAll('.model-card').forEach(card => {
    card.addEventListener('click', () => {
      const mid = card.dataset.mid;
      const model = state.models.find(m => m.id === mid);
      if (model) openModelDetail(model);
    });
  });
}

function modelCardHTML(m) {
  const now = Date.now();
  let statusHTML = '', countdownHTML = '';
  if (m.status === 'active') {
    const exp = new Date(m.expiresAt).getTime();
    const remaining = exp - now;
    statusHTML = '<span class="mc-status active">⚡ Active</span>';
    if (remaining > 0) {
      countdownHTML = `<div class="mc-countdown" data-expires="${m.expiresAt}">${fmtCountdown(remaining)}</div>`;
    }
  } else if (m.status === 'listed') {
    statusHTML = '<span class="mc-status listed">🛒 Listed</span>';
  } else {
    statusHTML = '<span class="mc-status dormant">💤 Dormant</span>';
  }
  const goldFx = m.tier === 'Gold' ? '<div class="glow-fx"></div>' : '';
  return `
    <div class="model-card tier-${m.tier}" data-mid="${m.id}">
      ${goldFx}
      <span class="mc-emoji">${m.emoji}</span>
      <div class="mc-tier tier-${m.tier}">${m.tier}</div>
      <div class="mc-name">${m.name}</div>
      ${statusHTML}
      ${m.status === 'active' ? `<div class="mc-zoom-rate">+${m.zoomPerHour} $ZOOM/h</div>` : ''}
      ${countdownHTML}
    </div>`;
}

function fmtCountdown(ms) {
  if (ms <= 0) return 'Expired';
  const s = Math.floor(ms / 1000);
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  const sec = s % 60;
  if (h >= 24) {
    const d = Math.floor(h / 24);
    return `${d}d ${h % 24}h`;
  }
  return `${pad(h)}:${pad(m)}:${pad(sec)}`;
}
function pad(n) { return String(n).padStart(2, '0'); }

// live countdown update
setInterval(() => {
  document.querySelectorAll('[data-expires]').forEach(el => {
    const exp = new Date(el.dataset.expires).getTime();
    const remaining = exp - Date.now();
    el.textContent = remaining > 0 ? fmtCountdown(remaining) : 'Expired';
  });
  // update exchange countdown
  updateExchangeCountdown();
}, 1000);

// tier filter
document.getElementById('tier-filter').addEventListener('click', (e) => {
  const btn = e.target.closest('.filter-btn');
  if (!btn) return;
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  state.filterTier = btn.dataset.tier;
  renderInventory();
  Telegram.WebApp.HapticFeedback.selectionChanged();
});

// ─── Model Detail Modal ───────────────────────────────────────────────────────
function openModelDetail(model) {
  state.selectedModel = model;
  const now = Date.now();
  const exp = model.expiresAt ? new Date(model.expiresAt).getTime() : 0;
  const remaining = exp - now;
  let statusContent = '';
  if (model.status === 'active') {
    statusContent = `<span style="color:var(--green)">⚡ Active — ${fmtCountdown(remaining)} left</span>`;
  } else if (model.status === 'dormant') {
    statusContent = '<span style="color:var(--text3)">💤 Dormant</span>';
  } else {
    statusContent = '<span style="color:var(--gold)">🛒 Listed on Market</span>';
  }

  const accumulated = Math.floor(model.accumulatedZoom || 0);

  let actionsHTML = '';
  if (model.status === 'dormant') {
    actionsHTML = `
      <button class="md-activate-btn" id="md-activate-btn">
        🔒 Activate (${model.tonFee} TON)
      </button>
      <div class="md-locked-note">Requires TON Payment module</div>`;
  } else if (model.status === 'active') {
    actionsHTML = `
      <button class="md-activate-btn" id="md-harvest-btn" style="border-color:rgba(0,255,149,0.3);background:rgba(0,255,149,0.1)">
        🌾 Harvest ${formatNum(accumulated)} $ZOOM
      </button>`;
  }

  document.getElementById('model-detail-content').innerHTML = `
    <div class="md-header">
      <span class="md-emoji">${model.emoji}</span>
      <span class="md-tier-badge ${model.tier}">${model.tier}</span>
      <div class="md-name">${model.name}</div>
      <div class="md-category">${model.category}</div>
    </div>
    <div class="md-stats-row">
      <div class="md-stat">
        <div class="md-stat-val" style="color:var(--green)">${model.zoomPerHour}</div>
        <div class="md-stat-lbl">$ZOOM/h</div>
      </div>
      <div class="md-stat">
        <div class="md-stat-val" style="color:var(--blue)">${model.tonFee} TON</div>
        <div class="md-stat-lbl">Activation</div>
      </div>
      <div class="md-stat">
        <div class="md-stat-val">${formatNum(accumulated)}</div>
        <div class="md-stat-lbl">Pending $ZOOM</div>
      </div>
    </div>
    <div class="md-status-row">
      <div class="md-status-label">STATUS</div>
      <div class="md-status-val">${statusContent}</div>
    </div>
    <div class="md-actions">
      ${actionsHTML}
    </div>
  `;

  openModal('modal-model');
  Telegram.WebApp.HapticFeedback.impactOccurred('light');

  // bind buttons
  const actBtn = document.getElementById('md-activate-btn');
  if (actBtn) {
    actBtn.addEventListener('click', () => {
      closeModal('modal-model');
      openLockedModal('TON Activation requires the TON Payment module. Once unlocked, paying ' + model.tonFee + ' TON activates ' + model.name + ' for 7 days of $ZOOM farming!');
    });
  }
  const harvestBtn = document.getElementById('md-harvest-btn');
  if (harvestBtn) {
    harvestBtn.addEventListener('click', () => doHarvest(model.id));
  }
}

async function doHarvest(modelId) {
  try {
    const data = await apiCall('/harvest/' + modelId, {
      method: 'POST',
      body: JSON.stringify({ telegramId: MY_ID })
    });
    state.user.zoom = data.zoom;
    updateHeaderUI();
    showToast('🌾 Harvested ' + formatNum(Math.floor(data.harvested)) + ' $ZOOM!');
    Telegram.WebApp.HapticFeedback.notificationOccurred('success');
    closeModal('modal-model');
    loadInventory(true);
  } catch (e) {
    showToast('Harvest failed');
  }
}


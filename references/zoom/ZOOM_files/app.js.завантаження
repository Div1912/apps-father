});

// ─── Locked Modal ─────────────────────────────────────────────────────────────
function openLockedModal(desc) {
  document.getElementById('locked-modal-desc').textContent = desc;
  openModal('modal-locked');
  Telegram.WebApp.HapticFeedback.notificationOccurred('warning');
}
document.getElementById('locked-close-btn').addEventListener('click', () => closeModal('modal-locked'));

// ─── Modal Helpers ────────────────────────────────────────────────────────────
function openModal(id) {
  const modal = document.getElementById(id);
  modal.classList.add('open');
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal(id);
  }, { once: false });
}
function closeModal(id) {
  document.getElementById(id).classList.remove('open');
}

// ─── Periodic Refresh ─────────────────────────────────────────────────────────
setInterval(() => {
  if (state.activeTab === 'inventory') loadInventory(true);
  if (state.activeTab === 'exchange') loadPool();
}, 30000);

// ─── Number Formatting ────────────────────────────────────────────────────────
function formatNum(n) {
  n = Math.floor(n);
  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(1) + 'K';
  return n.toString();
}


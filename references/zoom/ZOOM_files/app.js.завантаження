// ─── Exchange Screen ──────────────────────────────────────────────────────────
async function loadPool() {
  try {
    const pool = await apiCall('/pool');
    state.poolInfo = pool;
    document.getElementById('pool-ton').textContent = (+pool.tonBalance).toFixed(2);
    document.getElementById('pool-zoom-total').textContent = formatNum(Math.floor(pool.totalZoomProduced || 0));
    const rate = pool.conversionRate;
    document.getElementById('pool-rate').textContent = rate > 0 ? rate.toFixed(4) : '—';
    // est value
    const zoom = Math.floor(state.user?.zoom || 0);
    const estTon = rate > 0 ? (zoom * rate).toFixed(4) : '—';
    document.getElementById('my-zoom-est').textContent = '~' + estTon + ' TON';
    document.getElementById('my-zoom-balance').textContent = formatNum(zoom);
  } catch (e) {
    console.error('loadPool error', e);
  }
}

function updateExchangeCountdown() {
  const el = document.getElementById('exchange-countdown');
  if (!el) return;
  const now = new Date();
  const next = new Date(now.getFullYear(), now.getMonth() + 1, 1, 0, 0, 0);
  const ms = next - now;
  const d = Math.floor(ms / 86400000);
  const h = Math.floor((ms % 86400000) / 3600000);
  const m = Math.floor((ms % 3600000) / 60000);
  el.textContent = `${pad(d)}d ${pad(h)}h ${pad(m)}m`;
}
updateExchangeCountdown();

